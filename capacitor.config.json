{
  "appId": "org.hotelmanager.app",
  "appName": "HotelManager",
  "webDir": "www",
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#0d1b22"
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": false
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_notify",
      "iconColor": "#127C8A"
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "SplashScreen": {
      "launchShowDuration": 600,
      "backgroundColor": "#0E3B4F",
      "androidScaleType": "CENTER_INSIDE",
      "showSpinner": false
    }
  }
}
